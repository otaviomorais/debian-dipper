# 镜像文件不进 git（GitHub 单文件上限 100MB），统一放 Release
*.img
*.apk

# 第三方二进制工具：本地保留，不入库（README 说明去哪下载）
tools/
drivers/

# 本机私有 overlay（WiFi 密码等敏感配置，仓库是 Public，不能入库）
# 结构与 rootfs/ 一致，用 scripts/apply_local_overlay.sh 注入镜像
/local/

# 构建临时产物
__pycache__/
*.pyc
*.orig
*.rej

# Native keyboard build outputs
/fbkeyboard/fbkeyboard
/fbkeyboard/test-touch
/fbkeyboard/test-keyboard
/fbkeyboard/*.o
