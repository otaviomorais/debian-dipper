[Unit]
Description=Framebuffer soft keyboard (Xiaomi Mi 8 console)
ConditionPathExists=/dev/tty0
After=getty@tty1.service

[Service]
Type=exec
# Debian 的 DejaVu 字体路径与 Alpine 不同（/usr/share/fonts/truetype/dejavu/）
ExecStart=/usr/bin/fbkeyboard -f /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
ExecStartPre=-modprobe uinput
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
