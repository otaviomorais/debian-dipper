#!/bin/sh
set -eu
if [ "$(id -u)" = 0 ]; then
    echo 'Inicie dipper-console com seu usuário normal, sem sudo.' >&2
    exit 1
fi
if [ -n "${TMUX:-}" ]; then
    echo 'Você já está no tmux. Use F1 para o menu e F2 para outro terminal.'
    exit 0
fi
command -v tmux >/dev/null || { echo 'Instale tmux primeiro.' >&2; exit 1; }
# A separate socket/config leaves an existing personal tmux server untouched.
exec tmux -L dipper-console -f /etc/dipper-console/tmux.conf new-session -A -s dipper -n Terminal
